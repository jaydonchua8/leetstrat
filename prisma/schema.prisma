generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — the single source of truth. `src/types` re-exports these.
// ---------------------------------------------------------------------------

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum DataStructure {
  ARRAY
  STRING
  HASH_MAP
  HASH_SET
  LINKED_LIST
  STACK
  QUEUE
  DEQUE
  HEAP
  BINARY_TREE
  BINARY_SEARCH_TREE
  TRIE
  GRAPH
  MATRIX
  UNION_FIND
  SEGMENT_TREE
  FENWICK_TREE
  BIT_MANIPULATION
}

enum AlgorithmicTechnique {
  TWO_POINTERS
  SLIDING_WINDOW
  BINARY_SEARCH
  DFS
  BFS
  TOPOLOGICAL_SORT
  BACKTRACKING
  DYNAMIC_PROGRAMMING
  GREEDY
  DIVIDE_AND_CONQUER
  RECURSION
  SORTING
  PREFIX_SUM
  MONOTONIC_STACK
  FAST_SLOW_POINTERS
  INTERVALS
  MEMOIZATION
  SIMULATION
}

/// Ordered loosely by growth rate; see COMPLEXITY_RANK in src/types.
enum Complexity {
  O_1
  O_LOG_N
  O_SQRT_N
  O_N
  O_N_LOG_N
  O_N_SQUARED
  O_N_CUBED
  O_2_POW_N
  O_N_FACTORIAL
  O_N_TIMES_M
}

/// Which taxonomy a UserCategoryStat or CodexEntry row belongs to.
enum CategoryKind {
  DATA_STRUCTURE
  TECHNIQUE
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Denormalized counters. Kept in sync inside the submit transaction so the
  /// dashboard never has to aggregate the full Attempt table on read.
  totalAttempts     Int @default(0)
  totalFullyCorrect Int @default(0)

  attempts      Attempt[]
  categoryStats UserCategoryStat[]

  @@map("users")
}

/// The problem *statement* only. Ground truth lives on ReferenceAnswer so the
/// list/fetch endpoints can never leak it by forgetting a `select`.
model Problem {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String     @db.Text
  difficulty  Difficulty
  leetcodeId  Int?       @unique
  sourceUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referenceAnswer ReferenceAnswer?
  attempts        Attempt[]

  @@index([difficulty])
  @@map("problems")
}

/// Ground truth for one problem (1:1). Every categorical field is a
/// `primary` + `accepted[]` pair: the learner is correct if their pick is in
/// `accepted`, and misses are reported against `primary`. This is what lets
/// "Two Pointers" count for a Sliding Window problem without making the
/// grader lie about which answer is canonical.
model ReferenceAnswer {
  id        String @id @default(cuid())
  problemId String @unique

  primaryDataStructure   DataStructure
  acceptedDataStructures DataStructure[]

  primaryTechnique   AlgorithmicTechnique
  acceptedTechniques AlgorithmicTechnique[]

  primaryTimeComplexity    Complexity
  acceptedTimeComplexities Complexity[]

  primarySpaceComplexity    Complexity
  acceptedSpaceComplexities Complexity[]

  /// What to do, in one or two sentences.
  approachSummary String @db.Text
  /// Why this is the intended approach — the signals in the statement that
  /// should have pointed here. Shown on the result screen.
  explanation     String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problem   Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  edgeCases EdgeCase[]

  @@map("reference_answers")
}

/// One edge case the learner should have named. The learner answers in free
/// text, so each row carries lowercase `matchers` (phrases, synonyms,
/// shorthand like "n == 0"); any match counts as a hit.
model EdgeCase {
  id                String   @id @default(cuid())
  referenceAnswerId String
  description       String
  matchers          String[]
  explanation       String?  @db.Text

  referenceAnswer ReferenceAnswer @relation(fields: [referenceAnswerId], references: [id], onDelete: Cascade)

  @@index([referenceAnswerId])
  @@map("edge_cases")
}

/// An immutable log of one submission. The full graded breakdown is
/// snapshotted as JSON so GET /attempts/:id returns exactly what the learner
/// saw, even if the ReferenceAnswer is edited later. The boolean columns are
/// duplicated out of the JSON so they can be indexed and queried.
model Attempt {
  id        String @id @default(cuid())
  userId    String
  problemId String

  // --- User submission ---
  selectedDataStructure   DataStructure
  selectedTechnique       AlgorithmicTechnique
  selectedTimeComplexity  Complexity
  selectedSpaceComplexity Complexity
  edgeCasesText           String               @db.Text

  // --- Grading snapshot ---
  dataStructureCorrect   Boolean
  techniqueCorrect       Boolean
  timeComplexityCorrect  Boolean
  spaceComplexityCorrect Boolean
  edgeCasesCorrect       Boolean
  isFullyCorrect         Boolean
  /// Weighted 0..1 partial-credit score. See GRADING_WEIGHTS.
  score                  Float
  /// Serialized GradedAttempt.
  breakdown              Json

  /// Null when the feedback provider failed or was disabled — grading must
  /// never block on the LLM call.
  feedback   String? @db.Text
  durationMs Int?

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([problemId])
  @@map("attempts")
}

/// One row per (user, tag). This is the weak/strong signal: accuracy is
/// timesCorrect / timesSeen, where a "sighting" is either the tag appearing in
/// the ground truth or the user incorrectly selecting it.
model UserCategoryStat {
  id     String       @id @default(cuid())
  userId String
  kind   CategoryKind
  /// The enum member name, e.g. "SLIDING_WINDOW". Stored as text so both
  /// taxonomies share one table.
  key    String

  timesSeen    Int      @default(0)
  timesCorrect Int      @default(0)
  lastSeenAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, key])
  @@index([userId, kind])
  @@map("user_category_stats")
}

/// Browsable reference for one pattern or data structure. `(kind, key)` is the
/// enum member it documents, so any graded field maps to exactly one entry —
/// that is how result screens link a miss straight to the relevant page.
model CodexEntry {
  id      String       @id @default(cuid())
  slug    String       @unique
  kind    CategoryKind
  key     String
  title   String
  summary String       @db.Text
  /// "Reach for this when you see..." cues, one per element.
  signals String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, key])
  @@map("codex_entries")
}
